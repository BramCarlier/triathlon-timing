{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "triathlon-timing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "quality": "yarn lint && yarn format:check && yarn test:frontend && yarn typecheck && yarn build",
    "test:frontend": "node --test tests/Frontend/*.test.ts",
    "test:browser": "playwright test --project=chromium-smoke",
    "test:responsive": "playwright test --project=chromium-responsive --workers=3",
    "test:responsive:webkit": "playwright test --project=webkit-responsive --workers=3",
    "test:browser:all": "playwright test",
    "lint": "eslint resources/js tests/Browser tests/Frontend",
    "format": "prettier --write resources/js resources/css tests/Browser tests/Frontend",
    "format:check": "prettier --check resources/js resources/css tests/Browser tests/Frontend"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@inertiajs/vue3": "^3.11.0",
    "@lucide/vue": "^1.72.0",
    "laravel-echo": "^2.6.3",
    "pusher-js": "^8.4.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "laravel-vite-plugin": "^3.2.1",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "24.x"
  },
  "resolutions": {
    "minimatch": "^11.0.8"
  }
}
