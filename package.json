{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "triathlon-timing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "quality": "yarn test:frontend && yarn typecheck && yarn build",
    "test:frontend": "node --test tests/Frontend/*.test.ts",
    "test:browser": "playwright test --project=chromium-smoke",
    "test:responsive": "playwright test --project=chromium-responsive --workers=3",
    "test:responsive:webkit": "playwright test --project=webkit-responsive --workers=3",
    "test:browser:all": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@inertiajs/vue3": "^3.7.1",
    "axios": "^1.20.0",
    "laravel-echo": "^2.2.0",
    "pusher-js": "^8.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "laravel-vite-plugin": "^3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.x"
  }
}
