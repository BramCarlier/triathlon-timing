{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "bramcarlier/triathlon-timing",
  "type": "project",
  "description": "Race-day triathlon timing and checkpoint management for solo and relay participants.",
  "keywords": [
    "laravel",
    "triathlon",
    "timing",
    "race"
  ],
  "require": {
    "php": "^8.5",
    "dompdf/dompdf": "^3.1.6",
    "inertiajs/inertia-laravel": "^3.7",
    "laravel/framework": "^13.42",
    "laravel/reverb": "^1.13.0",
    "laravel/tinker": "^3.1",
    "maatwebsite/excel": "^4.0.6"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.15",
    "laravel/pail": "^1.3.0",
    "laravel/pint": "^1.32.3",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.6",
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "corepack yarn install --immutable",
      "yarn build"
    ],
    "test": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "format": [
      "pint"
    ],
    "lint": [
      "pint --test",
      "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.5.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
